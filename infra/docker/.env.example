#
# StravaFit-specific settings. The full .env is built by concatenating the
# upstream Supabase template with this file (see README step 3):
#
#   cat supabase/.env.example .env.example > .env
#   sh supabase/utils/generate-keys.sh --update-env
#
# Values below add our services. The two port bindings at the end deliberately
# override upstream values: in a dotenv file the last definition wins.

############
# Public endpoint
############
# Hostname Caddy serves and gets a TLS certificate for (DNS A/AAAA record
# must point at this machine). Use `localhost` for a local trial.
DOMAIN=localhost
# Public base URL of this instance (used by the tile server and the app).
PUBLIC_URL=https://localhost
HTTP_PORT=80
HTTPS_PORT=443

# These upstream Supabase settings must also point at the public URL. They are
# defined in the upstream template; set them to the same value as PUBLIC_URL.
#   SITE_URL, API_EXTERNAL_URL, SUPABASE_PUBLIC_URL
# Add the app deep link so email links open the app:
#   ADDITIONAL_REDIRECT_URLS=stravafit://auth-callback

############
# Map tiles
############
# Directory holding *.pmtiles files (see README "Map tiles").
TILES_DIR=./volumes/tiles
PMTILES_IMAGE=protomaps/go-pmtiles:v1.28.0
CADDY_IMAGE=caddy:2.8.4-alpine

############
# Worker (enable with --profile worker once the image is published)
############
WORKER_IMAGE=ghcr.io/warpirate/stravafit-worker:edge
WORKER_CONCURRENCY=2

############
# Host port bindings (override upstream)
############
# Keep the API gateway and the transaction pooler on loopback: Caddy reaches
# the gateway over the Docker network, and Docker-published ports bypass host
# firewalls such as ufw. See README "Security notes".
API_GW_HTTP_PORT=127.0.0.1:8000
POOLER_PROXY_PORT_TRANSACTION=127.0.0.1:6543
