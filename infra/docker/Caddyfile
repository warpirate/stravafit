# Single public entry point. Caddy obtains and renews TLS certificates for
# $DOMAIN automatically (ports 80/443 must reach this host). Use DOMAIN=localhost
# for a local trial with Caddy's internal CA.

{$DOMAIN} {
	encode zstd gzip

	# Self-hosted base map tiles (PMTiles), cacheable for a day.
	handle_path /tiles/* {
		header Cache-Control "public, max-age=86400"
		reverse_proxy tiles:8080
	}

	# Supabase API gateway, allow-listed. The gateway also routes `/` (Studio),
	# `/pg/` (postgres-meta), `/mcp` and the realtime admin API; none of those
	# are reachable from the internet. Reach Studio through an SSH tunnel.
	@api path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/* /graphql/v1 /graphql/v1/* /realtime/v1/websocket*
	handle @api {
		reverse_proxy api-gw:8000
	}

	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
