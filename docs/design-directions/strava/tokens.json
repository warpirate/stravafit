{
  "$description": "StravaFit design direction \"strava\" (ADR-014). W3C Design Tokens (DTCG) format. Source of truth: README.md and the DESIGN SPEC / :root blocks of the 14 HTML mockups in this folder. Where README.md and the HTML spec comment disagree, the value actually rendered by the HTML CSS wins and the difference is noted in $description.",
  "$extensions": {
    "org.stravafit": {
      "direction": "strava",
      "adr": "ADR-014",
      "distribution": "GitHub releases only",
      "rules": [
        "No Strava logo, wordmark or image assets; all icons, avatars and maps are our own.",
        "The social action is called High-five, never kudos.",
        "Every number uses tabular figures (font-feature-settings: tnum).",
        "Stat labels are Title Case; headings, buttons and body are sentence case; map area labels and chart month ticks are uppercase."
      ]
    }
  },

  "color": {
    "light": {
      "bg": { "$type": "color", "$value": "#FFFFFF", "$description": "Screen background, top app bar." },
      "surface": { "$type": "color", "$value": "#FFFFFF", "$description": "Cards, sheets, bottom nav." },
      "gap": { "$type": "color", "$value": "#EEEEF0", "$description": "8px gutter between edge-to-edge feed cards and You blocks. Never place `muted` text on it (4.4:1)." },
      "surface-2": { "$type": "color", "$value": "#F5F5F7", "$description": "Sunken wells (rare)." },
      "raised": { "$type": "color", "$value": "#FFFFFF", "$description": "Dialogs, raised panels." },
      "float": { "$type": "color", "$value": "#FFFFFF", "$description": "Round buttons, chips and search pill over maps, always with shadow.float." },
      "float-text": { "$type": "color", "$value": "#242428", "$description": "Content on float." },
      "sheet-over-map": { "$type": "color", "$value": "#FFFFFF", "$description": "Bottom sheet and record panel over a map." },
      "text": { "$type": "color", "$value": "#242428", "$description": "Titles, stat values (15.5:1 on white)." },
      "text-2": { "$type": "color", "$value": "#45454E", "$description": "Body, descriptions, feed switcher (9.5:1)." },
      "muted": { "$type": "color", "$value": "#6D6D78", "$description": "Stat labels, meta, timestamps, inactive nav (5.1:1 on white)." },
      "hair": { "$type": "color", "$value": "#E5E5EA", "$description": "Dividers, stat-row separators, app-bar and nav hairlines." },
      "hair-strong": { "$type": "color", "$value": "#CBCBD3", "$description": "Outlined round buttons, inactive sport circles, sheet handle, inactive page dots, rest-day dot." },
      "accent": { "$type": "color", "$value": "#FC5200", "$description": "Brand orange: fills, icons, route line, record button, active tab underline, chart line and area. White on it is 3.3:1: icons or >=19px/800 labels only." },
      "accent-press": { "$type": "color", "$value": "#E04A00", "$description": "Pressed accent." },
      "accent-text": { "$type": "color", "$value": "#CC3D00", "$description": "Small orange text: See all, active nav label, links (5.0:1)." },
      "accent-area": { "$type": "color", "$value": "#FC520024", "$description": "rgba(252,82,0,.14) accent wash." },
      "on-accent": { "$type": "color", "$value": "#FFFFFF", "$description": "Labels on accent, only at >=19px/800 or as icons." },
      "paused": { "$type": "color", "$value": "#C43B00", "$description": "Paused strip fill; white 14/700 label on it is 5.3:1." },
      "on-paused": { "$type": "color", "$value": "#FFFFFF", "$description": "Label on the paused strip." },
      "pill-inverse": { "$type": "color", "$value": "#242428", "$description": "Inverted chips (sport, active layer), Create route pill, gesture bar." },
      "on-pill-inverse": { "$type": "color", "$value": "#FFFFFF", "$description": "Text on pill-inverse." },
      "ok": { "$type": "color", "$value": "#16884A", "$description": "GPS ready dot, success." },
      "recording": { "$type": "color", "$value": "#E5322D", "$description": "Recording dot in the status pill (halo at 22% alpha)." },
      "paused-dot": { "$type": "color", "$value": "#E8A317", "$description": "Amber dot in the Paused pill (halo at 25% alpha)." },
      "error": { "$type": "color", "$value": "#C4281F", "$description": "Not in README; recording red darkened to 5.7:1 on white so error text passes AA." },
      "gold": { "$type": "color", "$value": "#D6A01E", "$description": "Medal 1." },
      "silver": { "$type": "color", "$value": "#9DA5AF", "$description": "Medal 2." },
      "bronze": { "$type": "color", "$value": "#C98A55", "$description": "Medal 3." },
      "on-medal": { "$type": "color", "$value": "#242428", "$description": "Medal numeral on every metal (6.6 / 6.2 / 5.3:1)." },
      "hr": { "$type": "color", "$value": "#E0245E", "$description": "Heart-rate glyph." },
      "bar": { "$type": "color", "$value": "#C3CCD8", "$description": "Split pace bars." },
      "bar-fast": { "$type": "color", "$value": "#FC5200", "$description": "Fastest split bar (where highlighted)." },
      "chart-line": { "$type": "color", "$value": "#3C78D8", "$description": "Pace line on activity analysis." },
      "chart-elev": { "$type": "color", "$value": "#E3E3E8", "$description": "Elevation area under the pace line." },
      "loc": { "$type": "color", "$value": "#2F74F0", "$description": "Live location dot and GPS halo." },
      "status": { "$type": "color", "$value": "#242428", "$description": "Status-bar content." },
      "route-start": { "$type": "color", "$value": "#1FA45B", "$description": "Route start marker (white ring)." }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#121214", "$description": "Screen behind app bars." },
      "surface": { "$type": "color", "$value": "#1C1C1F", "$description": "Cards, nav, sheets, panels, whole You header block." },
      "gap": { "$type": "color", "$value": "#000000", "$description": "True-black gutters between cards." },
      "surface-2": { "$type": "color", "$value": "#242428", "$description": "Sunken wells." },
      "raised": { "$type": "color", "$value": "#2A2A2F", "$description": "Dialogs, raised panels." },
      "float": { "$type": "color", "$value": "#2A2A2F", "$description": "Buttons and chips over maps." },
      "float-text": { "$type": "color", "$value": "#F2F2F4", "$description": "Content on float." },
      "sheet-over-map": { "$type": "color", "$value": "#232327", "$description": "Maps bottom sheet, lifted, with a hair-strong top edge." },
      "text": { "$type": "color", "$value": "#F2F2F4", "$description": "15.9:1 on surface." },
      "text-2": { "$type": "color", "$value": "#D2D2D8", "$description": "11.8:1." },
      "muted": { "$type": "color", "$value": "#A3A3AD", "$description": "6.9:1 on surface, 5.9:1 on raised." },
      "hair": { "$type": "color", "$value": "#2E2E34", "$description": "Dividers." },
      "hair-strong": { "$type": "color", "$value": "#43434B", "$description": "Outlines, handle, sheet top edge." },
      "accent": { "$type": "color", "$value": "#FC5200", "$description": "Same hue as light; 5.3:1 on surface." },
      "accent-press": { "$type": "color", "$value": "#FF6A2B", "$description": "Pressed accent (lighter in dark)." },
      "accent-text": { "$type": "color", "$value": "#FF6A2B", "$description": "Small orange text (6.2:1)." },
      "accent-area": { "$type": "color", "$value": "#FC52001A", "$description": "rgba(252,82,0,.10) accent wash." },
      "on-accent": { "$type": "color", "$value": "#FFFFFF", "$description": "Labels on accent, only at >=19px/800 or as icons." },
      "paused": { "$type": "color", "$value": "#C43B00", "$description": "Paused strip fill (same in both themes)." },
      "on-paused": { "$type": "color", "$value": "#FFFFFF", "$description": "Label on the paused strip." },
      "pill-inverse": { "$type": "color", "$value": "#F2F2F4", "$description": "Inverted chips, Create route pill, gesture bar." },
      "on-pill-inverse": { "$type": "color", "$value": "#18181B", "$description": "Text on pill-inverse." },
      "ok": { "$type": "color", "$value": "#3CC47A", "$description": "GPS ready." },
      "recording": { "$type": "color", "$value": "#E5322D", "$description": "Recording dot." },
      "paused-dot": { "$type": "color", "$value": "#E8A317", "$description": "Paused pill dot." },
      "error": { "$type": "color", "$value": "#FF5C5C", "$description": "Not in README; lightened recording red for text-safe error states on dark." },
      "gold": { "$type": "color", "$value": "#E7B43A", "$description": "Medal 1." },
      "silver": { "$type": "color", "$value": "#B4BBC4", "$description": "Medal 2." },
      "bronze": { "$type": "color", "$value": "#C98A55", "$description": "Medal 3." },
      "on-medal": { "$type": "color", "$value": "#242428", "$description": "Medal numeral." },
      "hr": { "$type": "color", "$value": "#FF5C8A", "$description": "Heart rate." },
      "bar": { "$type": "color", "$value": "#424B59", "$description": "Split bars." },
      "bar-fast": { "$type": "color", "$value": "#FC5200", "$description": "Fastest split bar." },
      "chart-line": { "$type": "color", "$value": "#6FA2F5", "$description": "Pace line." },
      "chart-elev": { "$type": "color", "$value": "#2C2C33", "$description": "Elevation area." },
      "loc": { "$type": "color", "$value": "#4C8DFF", "$description": "Location dot." },
      "status": { "$type": "color", "$value": "#F2F2F4", "$description": "Status-bar content." },
      "route-start": { "$type": "color", "$value": "#1FA45B", "$description": "Route start marker." }
    },
    "map": {
      "light": {
        "land": { "$type": "color", "$value": "#F2F1EC" },
        "built": { "$type": "color", "$value": "#ECEAE3", "$description": "Built-up landuse under the street grid." },
        "block": { "$type": "color", "$value": "#E9E7E0" },
        "park": { "$type": "color", "$value": "#CFE5BF" },
        "path": { "$type": "color", "$value": "#AFCB9A", "$description": "Dashed park footpaths." },
        "water": { "$type": "color", "$value": "#A7D0EA" },
        "road": { "$type": "color", "$value": "#FFFFFF", "$description": "Minor and secondary streets." },
        "road-case": { "$type": "color", "$value": "#E2DED5" },
        "major": { "$type": "color", "$value": "#FFFFFF" },
        "major-case": { "$type": "color", "$value": "#C7C0B2" },
        "arterial": { "$type": "color", "$value": "#FCE7B0" },
        "arterial-case": { "$type": "color", "$value": "#DDBA6E" },
        "rail": { "$type": "color", "$value": "#B4B0A6" },
        "poi": { "$type": "color", "$value": "#8A8790" },
        "label": { "$type": "color", "$value": "#5A5B61" },
        "road-label": { "$type": "color", "$value": "#55565C" },
        "water-label": { "$type": "color", "$value": "#33689A" },
        "park-label": { "$type": "color", "$value": "#3B6A2E" },
        "halo": { "$type": "color", "$value": "#F4F3EF" },
        "route": { "$type": "color", "$value": "#FC5200" },
        "route-case": { "$type": "color", "$value": "#FFFFFF" },
        "heat": { "$type": "color", "$value": "#EE3F0A" },
        "heat-core": { "$type": "color", "$value": "#C42600" },
        "heat-faint-opacity": { "$type": "number", "$value": 0.24 }
      },
      "dark": {
        "land": { "$type": "color", "$value": "#1A1C20" },
        "built": { "$type": "color", "$value": "#1D2025" },
        "block": { "$type": "color", "$value": "#1F2227" },
        "park": { "$type": "color", "$value": "#18291E" },
        "path": { "$type": "color", "$value": "#2C4434" },
        "water": { "$type": "color", "$value": "#11314A" },
        "road": { "$type": "color", "$value": "#2B2F36" },
        "road-case": { "$type": "color", "$value": "#1A1C20" },
        "major": { "$type": "color", "$value": "#3A3F48" },
        "major-case": { "$type": "color", "$value": "#262A30" },
        "arterial": { "$type": "color", "$value": "#4B4535" },
        "arterial-case": { "$type": "color", "$value": "#2F2B22" },
        "rail": { "$type": "color", "$value": "#454A53" },
        "poi": { "$type": "color", "$value": "#7D828C" },
        "label": { "$type": "color", "$value": "#A2A6B0" },
        "road-label": { "$type": "color", "$value": "#B3B7C0" },
        "water-label": { "$type": "color", "$value": "#78A6CF" },
        "park-label": { "$type": "color", "$value": "#86B48A" },
        "halo": { "$type": "color", "$value": "#1A1C20" },
        "route": { "$type": "color", "$value": "#FC5200" },
        "route-case": { "$type": "color", "$value": "#121214" },
        "heat": { "$type": "color", "$value": "#FF6A12" },
        "heat-core": { "$type": "color", "$value": "#FFC46B" },
        "heat-faint-opacity": { "$type": "number", "$value": 0.30 }
      }
    }
  },

  "font": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": ["Figtree", "system-ui", "sans-serif"], "$description": "Figtree (SIL OFL 1.1), closest open match to Strava's humanist grotesque. One family for text and numerals." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    },
    "feature": {
      "numeric": { "$type": "string", "$value": "tnum", "$description": "Applied to every number so live stats do not jitter." }
    },
    "unit-scale": { "$type": "number", "$value": 0.65, "$description": "Units beside values render at ~65% of the value size, weight 600, no tracking." }
  },

  "typography": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "84px", "fontWeight": 800, "lineHeight": 1.0, "letterSpacing": "-2.5px" }, "$description": "Live Time on Record (the only 800 numeral). Paused: 72px, -2px." },
    "stat-xl": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "52px", "fontWeight": 700, "lineHeight": 1.05, "letterSpacing": "-1px" }, "$description": "Live Split Avg and Distance. Paused: 48px." },
    "stat-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "26px", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.02em" }, "$description": "You > This week totals." },
    "title-xl": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "22px", "fontWeight": 800, "lineHeight": 1.2, "letterSpacing": "0px" }, "$description": "Activity title." },
    "top-bar-title": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "21px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.2px" }, "$description": "Screen titles (Home, You)." },
    "stat-m": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "20px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em" }, "$description": "Feed and detail stat values. HTML spec comment says 1.15; the rendered CSS uses 1.2." },
    "title-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "19px", "fontWeight": 700, "lineHeight": 1.25, "letterSpacing": "-0.2px" }, "$description": "Feed card title, section headers (Splits, Suggested routes)." },
    "title-m": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "15px", "fontWeight": 700, "lineHeight": 1.25, "letterSpacing": "0px" }, "$description": "Athlete name, route card name. HTML spec comment says 16/1.3; README and rendered CSS use 15/1.25." },
    "tab": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "15px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0px" }, "$description": "Progress | Activities tabs, feed switcher, Create route (700)." },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0px" }, "$description": "Descriptions." },
    "body-s": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0px" }, "$description": "Achievement line, chips (600), links (600)." },
    "button": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "14px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "0px" }, "$description": "Selector pills (Run, Add route), paused strip." },
    "button-hero": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "20px", "fontWeight": 800, "lineHeight": 1.0, "letterSpacing": "0px" }, "$description": "Start (20) and Finish (19) labels on accent." },
    "meta": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.35, "letterSpacing": "0px" }, "$description": "Date and place, device, counts." },
    "label": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.3, "letterSpacing": "0px" }, "$description": "Stat labels in Title Case. Record-screen labels use 13px/600 with the unit in the label." },
    "label-record": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "13px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0px" }, "$description": "Split Avg (/km), Distance (km)." },
    "nav": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "11px", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.1px" }, "$description": "Bottom-nav labels." },
    "map-area": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "10px", "fontWeight": 700, "lineHeight": 1.0, "letterSpacing": "1.4px" }, "$description": "Uppercase map area labels with a 3px halo." },
    "map-road": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "9.5px", "fontWeight": 600, "lineHeight": 1.0, "letterSpacing": "0px" }, "$description": "Road labels with halo." }
  },

  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "gutter": { "$type": "dimension", "$value": "16px", "$description": "Screen gutter and card horizontal padding." },
    "card-gap": { "$type": "dimension", "$value": "8px", "$description": "gap band between edge-to-edge feed cards." },
    "stat-column-gap": { "$type": "dimension", "$value": "34px", "$description": "Space between feed stat columns; no dividers." },
    "title-gap": { "$type": "dimension", "$value": "10px", "$description": "Feed card header to title." },
    "map-label-inset": { "$type": "dimension", "$value": "14px", "$description": "Min distance of map labels from frame side edges." }
  },

  "size": {
    "status-bar": { "$type": "dimension", "$value": "30px" },
    "top-app-bar": { "$type": "dimension", "$value": "52px" },
    "bottom-nav": { "$type": "dimension", "$value": "60px", "$description": "Plus a 20px gesture area." },
    "gesture-area": { "$type": "dimension", "$value": "20px" },
    "action-row": { "$type": "dimension", "$value": "48px" },
    "splits-row": { "$type": "dimension", "$value": "25px" },
    "tab-row": { "$type": "dimension", "$value": "46px" },
    "touch-min": { "$type": "dimension", "$value": "44px" },
    "icon": { "$type": "dimension", "$value": "24px", "$description": "Line icons, 1.75 stroke, round caps and joins." },
    "icon-action": { "$type": "dimension", "$value": "22px", "$description": "Social action row icons at 1.6 stroke." },
    "avatar-feed": { "$type": "dimension", "$value": "40px" },
    "avatar-facepile": { "$type": "dimension", "$value": "24px", "$description": "Overlap -7px, 2px ring in surface colour." },
    "feed-media": { "$type": "dimension", "$value": "236px", "$description": "Feed carousel and activity map hero height." },
    "page-dot": { "$type": "dimension", "$value": "6px" },
    "notification-dot": { "$type": "dimension", "$value": "9px", "$description": "Accent with a 2px bg-coloured ring." },
    "chip": { "$type": "dimension", "$value": "34px" },
    "selector-pill": { "$type": "dimension", "$value": "40px" },
    "float-button": { "$type": "dimension", "$value": "44px" },
    "sport-circle": { "$type": "dimension", "$value": "48px" },
    "record-secondary": { "$type": "dimension", "$value": "56px", "$description": "Sensors and Beacon outline buttons." },
    "record-start": { "$type": "dimension", "$value": "96px", "$description": "Start, Resume and Finish." },
    "record-stop": { "$type": "dimension", "$value": "84px" },
    "paused-strip": { "$type": "dimension", "$value": "34px" },
    "tab-indicator": { "$type": "dimension", "$value": "3px" },
    "route-thumb-width": { "$type": "dimension", "$value": "252px" },
    "route-thumb-height": { "$type": "dimension", "$value": "88px" }
  },

  "radius": {
    "none": { "$type": "dimension", "$value": "0px", "$description": "Cards, maps and photos in the feed." },
    "xs": { "$type": "dimension", "$value": "4px", "$description": "Buttons and inputs." },
    "s": { "$type": "dimension", "$value": "8px", "$description": "Route-card thumbnails." },
    "l": { "$type": "dimension", "$value": "16px", "$description": "Top of sheets and record panels." },
    "full": { "$type": "dimension", "$value": "999px", "$description": "Avatars, chips, search pill, round buttons, record button." }
  },

  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "ring-active": { "$type": "dimension", "$value": "2px", "$description": "Active sport circle, Resume outline." }
  },

  "elevation": {
    "flat": { "$type": "shadow", "$value": { "color": "#00000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }, "$description": "All surfaces not floating over a map." },
    "float-light": { "$type": "shadow", "$value": [
      { "color": "#00000029", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "#0000001A", "offsetX": "0px", "offsetY": "3px", "blur": "10px", "spread": "0px" }
    ], "$description": "Chips, round buttons, search pill over maps (light)." },
    "float-dark": { "$type": "shadow", "$value": [
      { "color": "#00000099", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "#00000073", "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px" }
    ], "$description": "Floating controls over maps (dark)." },
    "sheet": { "$type": "shadow", "$value": { "color": "#00000029", "offsetX": "0px", "offsetY": "-2px", "blur": "14px", "spread": "0px" }, "$description": "Record panel and Maps sheet. Dark Maps sheet: 0 -1px 0 hair-strong + 0 -4px 16px rgba(0,0,0,.5)." },
    "start-button": { "$type": "shadow", "$value": { "color": "#0000001F", "offsetX": "0px", "offsetY": "1px", "blur": "1px", "spread": "0px" }, "$description": "Only a 1px neutral shadow; never an orange glow." }
  },

  "motion": {
    "$description": "README.md and the HTML define no motion (static frames). These values carry over the existing app motion so Compose has a complete set; revisit against a real Strava build.",
    "duration": {
      "micro": { "$type": "duration", "$value": "100ms" },
