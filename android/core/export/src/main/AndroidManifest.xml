<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saving images to the gallery before Android 10 (scoped storage) needs this; never requested on 29+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package visibility (Android 11+): detect whether a story composer can receive the sticker. -->
    <queries>
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="com.instagram.share.ADD_TO_STORY" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application>
        <provider
            android:name="org.openactivity.core.export.share.ExportFileProvider"
            android:authorities="${applicationId}.export.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_file_paths" />
        </provider>
    </application>
</manifest>
