<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recording runs in a location foreground service started while the app is visible, so background
         location ("Allow all the time") is never needed. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- Android 11+ package visibility: find the installed text-to-speech engines for audio cues. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
