<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strava archive import: a WorkManager foreground worker with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Health Connect: write finished activities, read other apps' workouts (Settings, Health Connect). -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE_ROUTE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- The Health Connect app on Android 9 to 13. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".OpenActivityApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenActivity">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- singleTask: shortcuts, links and shared files reach the running app (onNewIntent) instead of
                 starting a second copy with its own recorder and import dialog. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launcher long-press shortcuts: Record Run, Record Ride. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Links to screens: openactivity://activity/{id}, route/{id}, record (see AppLinks). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openactivity" />
                <data android:host="activity" />
                <data android:host="route" />
                <data android:host="record" />
            </intent-filter>

            <!-- The same as web links on our host (Gradle property openactivity.linkHost). Without one the host
                 is under .invalid, which nobody can register, and nothing is verified. -->
            <intent-filter android:autoVerify="${linkAutoVerify}">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${linkHost}" />
                <data android:pathPrefix="/activities/" />
                <data android:pathPrefix="/routes/" />
                <data android:path="/record" />
            </intent-filter>

            <!-- "Open with": activity files by their own MIME types (platform-extras F1). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
            </intent-filter>

            <!--
                "Open with" for providers that report a generic type: only names ending in .gpx, .tcx,
                .fit or their .gz forms. Android's path patterns stop at the first dot, so the patterns
                repeat for names with up to two more dots.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\.GPX" />
                <data android:pathPattern=".*\\..*\\.GPX" />
                <data android:pathPattern=".*\\..*\\..*\\.GPX" />
                <data android:pathPattern=".*\\.tcx" />
                <data android:pathPattern=".*\\..*\\.tcx" />
                <data android:pathPattern=".*\\..*\\..*\\.tcx" />
                <data android:pathPattern=".*\\.TCX" />
                <data android:pathPattern=".*\\..*\\.TCX" />
                <data android:pathPattern=".*\\..*\\..*\\.TCX" />
                <data android:pathPattern=".*\\.fit" />
                <data android:pathPattern=".*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\.FIT" />
                <data android:pathPattern=".*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\.gpx\\.gz" />
                <data android:pathPattern=".*\\..*\\.gpx\\.gz" />
                <data android:pathPattern=".*\\..*\\..*\\.gpx\\.gz" />
                <data android:pathPattern=".*\\.GPX\\.GZ" />
                <data android:pathPattern=".*\\..*\\.GPX\\.GZ" />
                <data android:pathPattern=".*\\..*\\..*\\.GPX\\.GZ" />
                <data android:pathPattern=".*\\.tcx\\.gz" />
                <data android:pathPattern=".*\\..*\\.tcx\\.gz" />
                <data android:pathPattern=".*\\..*\\..*\\.tcx\\.gz" />
                <data android:pathPattern=".*\\.TCX\\.GZ" />
                <data android:pathPattern=".*\\..*\\.TCX\\.GZ" />
                <data android:pathPattern=".*\\..*\\..*\\.TCX\\.GZ" />
                <data android:pathPattern=".*\\.fit\\.gz" />
                <data android:pathPattern=".*\\..*\\.fit\\.gz" />
                <data android:pathPattern=".*\\..*\\..*\\.fit\\.gz" />
                <data android:pathPattern=".*\\.FIT\\.GZ" />
                <data android:pathPattern=".*\\..*\\.FIT\\.GZ" />
                <data android:pathPattern=".*\\..*\\..*\\.FIT\\.GZ" />
            </intent-filter>

            <!-- Health Connect on Android 13 and lower: "why does StravaFit want this?" opens the privacy information. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Share sheet. Watches and other apps often send FIT files as octet-stream; the importer checks the content.
                 A ZIP is a Strava archive and goes to the Strava import. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <!-- Health Connect on Android 14 and later: the same privacy information, behind the system's own permission. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- WorkManager's foreground service runs the Strava import (data sync, Android 14 types). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
