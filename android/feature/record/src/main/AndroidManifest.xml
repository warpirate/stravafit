<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Record detail 1.4: ask once to exempt the app from battery savers that stop recordings with the
         screen off. Allowed for this app, which is distributed outside Google Play (ADR-014). -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <queries>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
            <data android:scheme="package" />
        </intent>
        <!-- Record detail 7.5: warn before the first recording when no text-to-speech engine is installed. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
