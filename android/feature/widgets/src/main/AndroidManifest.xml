<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Recording widget: start, pause and finish without opening the app. -->
        <receiver
            android:name=".StravaFitWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stravafit_widget_info" />
        </receiver>

        <!-- This week: totals against the weekly goal; opens the You tab. -->
        <receiver
            android:name=".WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/week_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <!-- Last activity: title, stats and route; opens the activity. -->
        <receiver
            android:name=".LastActivityWidgetReceiver"
            android:exported="true"
            android:label="@string/last_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/last_activity_widget_info" />
        </receiver>

        <!-- Quick Settings "Record" tile. -->
        <service
            android:name=".RecordTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_record"
            android:label="@string/tile_record"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
